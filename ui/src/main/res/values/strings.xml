    <string name="help_contrast" formatted="false">Adjust the difference between light and dark areas. The default strength is 100%.</string>
    <string name="help_gamma" formatted="false">Adjust midtones. The default strength is 100%.</string>
    <string name="help_saturation" formatted="false">Adjust color saturation. The default strength is 100%.</string>
