    <string name="help_screen_preset" formatted="false">Choose a saved screen arrangement.</string>
    <string name="help_screen_size" formatted="false">Adjust the screen size. Use the minus and plus buttons for fine adjustments.</string>
    <string name="help_enable_ai3d" formatted="false">Generate depth from the input image and synthesize stereo views for both eyes.</string>
    <string name="help_type" formatted="false">Still suits static content. Movie suits continuously changing video.</string>
    <string name="help_model" formatted="false">Choose a depth model. Available models depend on the device and installed assets.</string>
    <string name="help_algorithm" formatted="false">Direct shift moves pixels using depth.\nParallax searches an offset map and applies iterative correction.</string>
    <string name="help_eye_order" formatted="false">Normal keeps the usual eye order. Crossed swaps the left and right images.</string>
    <string name="help_separation" formatted="false">Adjust stereo disparity. High values may cause discomfort; increase gradually from a low value.</string>
    <string name="help_convergence" formatted="false">Adjust the zero-parallax plane to change how far content appears in front of or behind the screen.</string>
    <string name="help_depth_strength" formatted="false">Adjust how strongly depth affects the stereo result.</string>
    <string name="help_depth_smoothing" formatted="false">Gaussian smooths depth noise. Color guided smoothing follows color edges.</string>
    <string name="help_depth_preview" formatted="false">Show depth information on the screen to inspect foreground and background estimates.</string>
    <string name="help_depth_sync" formatted="false">Balance alignment between depth results and video frames against latency.</string>
    <string name="help_ai_priority" formatted="false">Adjust depth-computation priority. Higher priority may increase resource use.</string>
    <string name="help_depth_rate_limit" formatted="false">Limit depth maps per second to balance smoothness, power consumption, and temperature.</string>
    <string name="help_cursor_type" formatted="false">Choose a circular cursor or an arrow pointer.</string>
    <string name="help_cursor_smoothing" formatted="false">Smooth small ray movements. Stronger smoothing may add response delay.</string>
    <string name="help_button_mapping" formatted="false">Map controller buttons to remote input.</string>
